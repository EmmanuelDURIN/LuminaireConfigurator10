@page "/configurationlist"
@page "/configurations"
@attribute [StreamRendering]

@using LuminaireConfigurator10.Client.Model

<PageTitle>Configurations</PageTitle>

<h1>Configurations</h1>

<p>These are some luminaire configurations.</p>

@if (luminaireConfigurations == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Configuration Name</th>
                <th>Creation Date</th>
                <th>Lamp Color</th>
                <th>Optic</th>
                <th>LampFlux (lm)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (LuminaireConfiguration configuration in luminaireConfigurations)
            {
                <tr>
                    <td><a href="/configurationdetails/@configuration.Id">@configuration.Name</a></td>
                    <td>@configuration.CreationTime.ToShortDateString()</td>
                    <td>@configuration.LampColor (°K)</td>
                    <td>@configuration.Optic</td>
                    <td>@configuration.LampFlux</td>
                </tr>

            }
        </tbody>
    </table>
}
