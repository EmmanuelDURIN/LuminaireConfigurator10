@typeparam TItem
@typeparam TValue
@typeparam TDisplay

<select class="form-control" @onchange="OnSelectedChanged">
    @ChildContent
    @foreach (var item in Items)
    {
        bool isSelected = item?.Equals(Selected) == true;
        <option value="@ValueSelector(item)" selected="@isSelected">@DisplaySelector(item)</option>
    }
</select>